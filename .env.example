GITHUB_DATA_OWNER=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=main
GITHUB_TOKEN=

# Optional: if set, the entire app (pages + API) requires this token to access —
# either by logging in at /login (sets a cookie) or via `Authorization: Bearer <token>`
# (used by the browser extension). Leave blank to keep the app open, as in V1 default.
APP_ACCESS_TOKEN=
